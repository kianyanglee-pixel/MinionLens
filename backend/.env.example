SUPABASE_URL = 'https://bpjquocjqvwtamlqjchs.supabase.co'
SUPABASE_KEY = ''
SUPABASE_BUCKET = 'emails_and_attachment'

# AWS S3 ingestion (source_type=cloud, s3:// URIs) — IAM user/role needs
# s3:ListBucket + s3:GetObject on the target bucket. Leave blank to fall
# back to an unsigned client, which only works against public buckets.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION=""

# Google Cloud Storage ingestion (source_type=cloud, gs:// URIs) — path to a
# GCP service-account JSON key file with roles/storage.objectViewer on the
# bucket. Leave blank to try application-default credentials, then fall
# back to an anonymous client (public buckets only).
GOOGLE_APPLICATION_CREDENTIALS = ''

# Google Drive ingestion (source_type=drive) — a Google Cloud API key with
# the Drive API v3 enabled. Only works for folders shared as "Anyone with
# the link"; an API key alone cannot list files in a private Drive folder.
GOOGLE_API_KEY = ''

# LLM provider — llm.py has one active client block, marked "(ACTIVE)" in
# that file, and the rest commented out. Only fill in the keys for whichever
# block is actually active there; the rest are unused placeholders.
OPENROUTER_API_KEY = ''
OPENROUTER_MODEL = 'google/gemini-2.5-flash'

GEMINI_API_KEY = ''
GEMINI_MODEL = 'gemini-3.6-flash'

OPENAI_API_KEY = ''
OPENAI_MODEL = 'gpt-4o-mini'

# Ollama (local, free, no API key needed) — see llm.py for setup notes. Both
# have sane local defaults, so you can leave these unset unless your Ollama
# server/model differs from the defaults.
OLLAMA_BASE_URL = 'http://localhost:11434/v1'
OLLAMA_MODEL = 'llama3.1:8b'
